<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Justificação do Voto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Por que você votou neste candidato? Selecione pelo menos uma opção:"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <RadioGroup
            android:id="@+id/radioGroupReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbEducacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Educação"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbSaude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saúde"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbSaneamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saneamento básico"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbSeguranca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Segurança pública"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbEconomia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desenvolvimento econômico"
                android:textSize="16sp"
                android:padding="8dp" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descreva com mais detalhes (Opcional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReasonDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishSurvey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar Pesquisa"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
