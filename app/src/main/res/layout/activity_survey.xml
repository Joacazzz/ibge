<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesquisa Presidencial 2026"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Em qual destes candidatos você votaria neste ano?"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/radioGroupPresidents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbGetulio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Getúlio Vargas"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbFhc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fernando Henrique Cardoso"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbJango"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="João 'Jango' Goulart"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbNilo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nilo Peçanha"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbJk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Juscelino Kubitschek"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbBranco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voto em Branco"
                android:textSize="16sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbNulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voto Nulo"
                android:textSize="16sp"
                android:padding="8dp" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitVote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
